    public void validRFC3339DateStringWithUTCTimezone() {
        String source = "2023-10-01T12:34:56Z";
        Date expectedDate = new Date();
        when(rfc3339DateFormat.fmt.parse(source, pos)).thenReturn(expectedDate);
        Date actualDate = rfc3339DateFormat.parse(source, pos);
        assertNotNull(actualDate);
        assertEquals(-1, pos.getErrorIndex());
    }
    @Test
    @Tag("invalid")
    public void invalidRFC3339DateString() {
        String source = "invalid-date-string";
        when(rfc3339DateFormat.fmt.parse(source, pos)).thenReturn(null);
        Date actualDate = rfc3339DateFormat.parse(source, pos);
        assertNull(actualDate);
        assertTrue(pos.getErrorIndex() >= 0);
    }
