    public void testGetRequestWhenRequestIsNull() {
        PasswordApiController controller = new PasswordApiController(null);
        Optional<NativeWebRequest> result = controller.getRequest();
        assertFalse(result.isPresent(), "Expected empty Optional when request is null");
    }
    @Test
    @Tag("valid")
    public void testGetRequestWhenRequestIsNotNull() {
        MockHttpServletRequest mockHttpServletRequest = new MockHttpServletRequest();
        RequestContextHolder.setRequestAttributes(new ServletRequestAttributes(mockHttpServletRequest));
        NativeWebRequest request = RequestContextHolder.getRequestAttributes();
        PasswordApiController controller = new PasswordApiController(request);
        Optional<NativeWebRequest> result = controller.getRequest();
        assertTrue(result.isPresent(), "Expected non-empty Optional when request is not null");
        assertSame(request, result.get(), "Expected the original request to be returned");
    }
    @Test
    @Tag("valid")
    public void testGetRequestDoesNotModifyRequest() {
        MockHttpServletRequest mockHttpServletRequest = new MockHttpServletRequest();
        RequestContextHolder.setRequestAttributes(new ServletRequestAttributes(mockHttpServletRequest));
        NativeWebRequest request = RequestContextHolder.getRequestAttributes();
        PasswordApiController controller = new PasswordApiController(request);
        Optional<NativeWebRequest> result1 = controller.getRequest();
        Optional<NativeWebRequest> result2 = controller.getRequest();
        assertSame(result1.get(), result2.get(), "Expected the same request to be returned on multiple invocations");
    }
