package org.openapitools.configuration;import org.junit.jupiter.api.BeforeEach;
import org.junit.jupiter.api.Tag;
import org.junit.jupiter.api.Test;
import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.boot.test.autoconfigure.web.servlet.WebMvcTest;
import org.springframework.test.web.servlet.MockMvc;
import org.springframework.test.web.servlet.request.MockMvcRequestBuilders;
import org.springframework.test.web.servlet.result.MockMvcResultMatchers;
import java.util.Locale; // Imported Locale HomeControllerIndexTest static org.springframework.test.web.servlet.result.MockMvcResultMatchers.redirectedUrl;
import org.springframework.context.annotation.Bean;
import org.springframework.stereotype.Controller;
import org.springframework.web.bind.annotation.RequestMapping;
import org.springframework.web.bind.annotation.ResponseBody;
import org.springframework.web.bind.annotation.GetMapping;

@WebMvcTest(HomeController.class)
 HomeControllerIndexTest {
    @Autowired
    private MockMvc mockMvc;
    @BeforeEach
    public void setUp() {
        // TODO: Add any setup code required for the tests
    }
    @Test
    @Tag("valid")
    public void indexRedirectsToSwaggerUi() throws Exception {
        mockMvc.perform(MockMvcRequestBuilders.get("/"))
                .andExpect(MockMvcResultMatchers.status().is3xxRedirection())
                .andExpect(redirectedUrl("swagger-ui.html"));
    }
    @Test
    @Tag("valid")
    public void indexHandlesRootPath() throws Exception {
        mockMvc.perform(MockMvcRequestBuilders.get("/"))
                .andExpect(MockMvcResultMatchers.status().is3xxRedirection())
                .andExpect(redirectedUrl("swagger-ui.html"));
    }
    @Test
    @Tag("valid")
    public void indexReturnsCorrectViewName() throws Exception {
        mockMvc.perform(MockMvcRequestBuilders.get("/"))
                .andExpect(MockMvcResultMatchers.status().is3xxRedirection())
                .andExpect(redirectedUrl("swagger-ui.html"));
    }
    @Test
    @Tag("valid")
    public void indexHandlesDifferentUrlPatterns() throws Exception {
        mockMvc.perform(MockMvcRequestBuilders.get("/"))
                .andExpect(MockMvcResultMatchers.status().is3xxRedirection())
                .andExpect(redirectedUrl("swagger-ui.html"));
    }
    @Test
    @Tag("valid")
    public void indexDoesNotModifyBasePath() throws Exception {
        mockMvc.perform(MockMvcRequestBuilders.get("/"))
                .andExpect(MockMvcResultMatchers.status().is3xxRedirection())
                .andExpect(redirectedUrl("swagger-ui.html"));
    }
    @Test
    @Tag("valid")
    public void indexHandlesAdditionalQueryParameters() throws Exception {
        mockMvc.perform(MockMvcRequestBuilders.get("/?param1=value1&param2=value2"))
                .andExpect(MockMvcResultMatchers.status().is3xxRedirection())
                .andExpect(redirectedUrl("swagger-ui.html"));
    }
    @Test
    @Tag("valid")
    public void indexHandlesDifferentHttpMethods() throws Exception {
        mockMvc.perform(MockMvcRequestBuilders.post("/"))
                .andExpect(MockMvcResultMatchers.status().is3xxRedirection())
                .andExpect(redirectedUrl("swagger-ui.html"));
    }
    @Test
    @Tag("valid")
    public void indexDoesNotThrowExceptionsForValidRequests() throws Exception {
        mockMvc.perform(MockMvcRequestBuilders.get("/"))
                .andExpect(MockMvcResultMatchers.status().is3xxRedirection())
                .andExpect(redirectedUrl("swagger-ui.html"));
    }
    @Test
    @Tag("valid")
    public void indexHandlesDifferentLocaleSettings() throws Exception {
        mockMvc.perform(MockMvcRequestBuilders.get("/").locale(new Locale("fr")))
                .andExpect(MockMvcResultMatchers.status().is3xxRedirection())
